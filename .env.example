# Externe Ports (Host)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# SQLite-Dateiname (wird im data/-Ordner angelegt)
DB_NAME=watchtracker.db

# TMDB API Key
# Registriere dich kostenlos unter https://www.themoviedb.org/settings/api
# und erstelle einen API Read Access Token (v4 auth).
TMDB_API_KEY=dein_tmdb_api_key_hier
